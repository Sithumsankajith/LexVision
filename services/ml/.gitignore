# ML Ignore Rules
datasets/*
!datasets/README.md

# Ignore large model files
models/*.pt
models/*.pth
models/*.h5
models/*.onnx
models/*.pb

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Environment variables (never commit secrets!)
.env
.env.*
!.env.example

# SQLite fallback DB
*.sqlite3
*.sqlite3-*
db.sqlite3

# Python runtime and local tooling
.venv/
venv/
.pytest_cache/

# Local temp/debug outputs
temp/
logs/
